{
  "name": "beaconbob",
  "displayName": "BeaconBob",
  "description": "Zero-cloud pair programming on your LAN: discovery, encrypted chat and groups, live shared editing, and voice. No accounts, no servers.",
  "version": "0.1.0",
  "publisher": "yassataiseer",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yassataiseer/beaconbob.git"
  },
  "bugs": {
    "url": "https://github.com/yassataiseer/beaconbob/issues"
  },
  "homepage": "https://github.com/yassataiseer/beaconbob#readme",
  "galleryBanner": {
    "color": "#1f2a44",
    "theme": "dark"
  },
  "keywords": [
    "pair programming",
    "collaboration",
    "live share",
    "lan",
    "offline",
    "peer-to-peer",
    "chat",
    "voice",
    "co-editing"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:beaconbob"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beaconbob",
          "title": "BeaconBob",
          "icon": "media/beacon.svg"
        }
      ]
    },
    "views": {
      "beaconbob": [
        {
          "type": "webview",
          "id": "beaconbob.sidebar",
          "name": "Session"
        },
        {
          "id": "beaconbob.sharedFiles",
          "name": "Shared files",
          "when": "beaconbob.hasSharedFiles"
        }
      ]
    },
    "commands": [
      {
        "command": "beaconbob.connect",
        "title": "Connect to Peer",
        "category": "BeaconBob"
      },
      {
        "command": "beaconbob.disconnect",
        "title": "Disconnect from Peer",
        "category": "BeaconBob"
      },
      {
        "command": "beaconbob.showLogs",
        "title": "Show Logs",
        "category": "BeaconBob"
      },
      {
        "command": "beaconbob.stopSharing",
        "title": "Stop Sharing Workspace",
        "category": "BeaconBob"
      }
    ],
    "configuration": {
      "title": "BeaconBob",
      "properties": {
        "beaconbob.displayName": {
          "type": "string",
          "default": "",
          "description": "Name shown to other peers on the LAN. Defaults to your OS user name."
        },
        "beaconbob.portRange": {
          "type": "string",
          "default": "42520-42560",
          "pattern": "^\\d{1,5}-\\d{1,5}$",
          "description": "TCP port range used by the local signaling server, as 'min-max'."
        },
        "beaconbob.sharing.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git/",
            "node_modules/",
            ".env",
            ".env.*",
            "*.pem",
            "*.key",
            "id_rsa*"
          ],
          "description": "Gitignore-style patterns hidden from guests when you share your workspace (in addition to the root .gitignore)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.mts",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --config webview-ui/vite.config.mts --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview-ui --noEmit",
    "test": "vitest run",
    "test:vscode": "node test/vscode/run.mjs",
    "package": "vsce package --no-dependencies -o beaconbob.vsix",
    "publish:vsce": "vsce publish --no-dependencies --packagePath beaconbob.vsix",
    "publish:ovsx": "ovsx publish beaconbob.vsix",
    "vscode:prepublish": "node esbuild.mjs --production && npm run build:webview"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ignore": "^7.0.12",
    "lib0": "^0.2.119",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.90.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
